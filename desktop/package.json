{
  "name": "branshee-desktop",
  "version": "2.0.0",
  "description": "Branshee — application de bureau (Windows, macOS, Linux)",
  "main": "main.js",
  "private": true,
  "author": "Branshee",
  "scripts": {
    "start": "electron .",
    "dev": "BRANSHEE_URL=http://localhost:3000 electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.branshee.desktop",
    "productName": "Branshee",
    "files": ["main.js", "preload.js", "offline.html", "assets/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "Branshee" },
    "mac": { "target": "dmg", "icon": "assets/icon.png", "category": "public.app-category.business" },
    "linux": { "target": "AppImage", "icon": "assets/icon.png", "category": "Office" }
  }
}
