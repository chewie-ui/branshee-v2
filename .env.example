# Connexion PostgreSQL (sur le VPS : base dédiée, utilisateur dédié)
DATABASE_URL=postgres://branshee:motdepasse@localhost:5432/branshee

# Adresse publique du site (liens de réservation, emails)
APP_URL=http://localhost:3000

# Envoi des emails (SMTP). Sans SMTP_URL, les emails sont seulement affichés dans la console.
SMTP_URL=
MAIL_FROM="Branshee <no-reply@branshee.com>"

# Secret partagé avec la crontab qui déclenche les rappels (openssl rand -hex 32)
CRON_SECRET=
