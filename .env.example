# Connexion PostgreSQL (sur le VPS : base dédiée, utilisateur dédié)
DATABASE_URL=postgres://branshee:motdepasse@localhost:5432/branshee

# Adresse publique du site (liens de réservation, emails)
APP_URL=http://localhost:3000

# Envoi des emails (SMTP). Sans SMTP_URL, les emails sont seulement affichés dans la console.
SMTP_URL=
MAIL_FROM="Branshee <no-reply@branshee.com>"

# Secret partagé avec la crontab qui déclenche les rappels (openssl rand -hex 32)
CRON_SECRET=

# Clé de chiffrement des données sensibles (openssl rand -hex 32). À SAUVEGARDER : sans elle, les dossiers clients sont illisibles.
DATA_ENCRYPTION_KEY=

# Dossier des fichiers envoyés (PDF des dossiers, chiffrés ; images publiques). À SAUVEGARDER avec la base.
STORAGE_DIR=./storage

# Paiements (Stripe) — laisser vide pour désactiver le paiement en ligne
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Abonnements Branshee (prix Stripe des forfaits et options) + webhook
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PROPLUS_MONTHLY=
STRIPE_PRICE_PROPLUS_YEARLY=
STRIPE_PRICE_CUSTOM_URL=
STRIPE_PRICE_EXTRA_SEAT=
STRIPE_WEBHOOK_SECRET=

# SMS et WhatsApp (API Cloud Meta) — vides = désactivés (repli email)
# SMS : Brevo (par défaut) ou Twilio (SMS_PROVIDER=twilio)
BREVO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_SENDER=Branshee
SMS_DEFAULT_CC=32
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=rdv_rappel
WHATSAPP_CONFIRMATION_TEMPLATE=rdv_confirmation

# Google (connexion + Google Agenda) — redirection autorisée : <APP_URL>/auth/google/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Application mobile : identifiants OAuth des apps iOS / Android / web (mêmes valeurs que sur l'ancien serveur)
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
# « Se connecter avec Apple » (app iOS) : identifiant de bundle, et Service ID si le bouton existe ailleurs
APPLE_BUNDLE_ID=com.branshee.pro
APPLE_SERVICE_ID=

# Support : adresse qui reçoit les messages du chat et affichée dans l'aide ; WhatsApp (numéro international sans +)
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
